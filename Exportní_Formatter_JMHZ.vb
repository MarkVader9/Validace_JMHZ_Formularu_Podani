Set cdl = CommonDialog1 ' nutné před inicializací - připojuje common dialog
        InitLp ' funkce
        If PrintAno = "N" Then: Exit Sub
   Printer.FontName = "Salary":
   Printer.FontSize = 9
F = FreeFile
             FVystup = "Tisk.rtf"
           If FileExist(FVystup) Then ' když je soubor vytvořen
           For PocetKopii = 1 To cdl.Copies
                 Open FVystup For Input As #F  ' otevři soubor
                Zac = 0
                  Do While Not EOF(F)
                     Line Input #F, veta  ' načti řádek ze souboru
                     If InStr(1, veta, "strana") > 0 And Zac = 1 Then
                       Printer.NewPage:
                        For i = 1 To 3: Printer.Print " ": Next i
                     End If

                     If Zac = 0 Then: For i = 1 To 3: Printer.Print " ": Next i
                     
                     Printer.Print Trim(veta) ' tiskni načtený řádek
                     Zac = 1
                       
                  Loop
                    Close F  ' zavři soubor
               Printer.EndDoc ' zavři tiskárnu
               Next PocetKopii
           Else
           
           MsgBox ("Soubor tisku není vytvořen")
           End If
  
End Sub

