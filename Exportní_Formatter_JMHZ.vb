Public Function EncodeFileToBase64(ByVal sFilePath As String) As String
    Dim objXML As Object
    Dim objNode As Object
    Dim b() As Byte
    Dim F As Integer
    
    If FileExist(sFilePath) Then
    Else
        ' Zobrazení varovného dialogu pro uživatele s přesnými instrukcemi
        MsgBox "Na zadané cestě neexistuje soubor přílohy s názvem '" & sFilePath & "'!" & vbCrLf & vbCrLf & _
               "Hledaná cesta: " & sFilePath & vbCrLf & vbCrLf & _
               "Ujistěte se prosím, že v dané cílové složce tento soubor skutečně existuje, " & _
               "a poté ukládání příloh zopakujte."
        ' Přerušíme běh exportu, aby se nevygenerovalo XML bez požadované přílohy
         Exit Function
    End If
    
    ' 1. Otevření souboru a načtení do bytového pole
    F = FreeFile
    Open sFilePath For Binary Access Read As #F
    ReDim b(LOF(F) - 1)
    Get #F, , b
    Close #F
    
    ' 2. Využití MSXML pro rychlý Base64 převod
    Set objXML = CreateObject("MSXML2.DOMDocument")
    Set objNode = objXML.createElement("b64")
    
    objNode.DataType = "bin.base64"
    objNode.nodeTypedValue = b
    
    ' Odstranění odřádkování (XML parser někdy do Base64 vkládá vbLf)
    EncodeFileToBase64 = Replace(objNode.Text, vbLf, "")
    
    Set objNode = Nothing
    Set objXML = Nothing
    
End Function

