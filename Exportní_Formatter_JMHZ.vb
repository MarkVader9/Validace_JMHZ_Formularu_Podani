Sub RozdelTextNaRadky85(ByVal Zdroj As String, ByRef Vystup() As String)
    Dim Slova() As String
    Dim Radek As String
    Dim ii As Long, j As Long

    Slova = Split(Zdroj, " ")
    ReDim Vystup(1 To 1)
    j = 1
    Radek = ""

    For ii = 0 To UBound(Slova)
        If Len(Radek & " " & Slova(ii)) <= 130 Then
            If Radek = "" Then
                Radek = Slova(ii)
            Else
                Radek = Radek & " " & Slova(ii)
            End If
        Else
            Vystup(j) = Radek
            j = j + 1
            ReDim Preserve Vystup(1 To j)
            Radek = Slova(ii)
        End If
    Next ii

    If Radek <> "" Then
        Vystup(j) = Radek
    End If
End Sub


Private Sub SloucitXML()
    Dim cesta1 As String, cesta2 As String, cestaVysledek As String
    Dim txt1 As String, TxT2 As String
    Dim body1 As String, body2 As String
    
    cesta1 = PathXml & "\JMHZ1.xml"
    cesta2 = PathXml & "\JMHZ2.XML"
    cestaVysledek = PathXml & "\JMHZ.xml"
    
    ' --- načtení prvního XML ---
    Open cesta1 For Input As #3
        txt1 = Input$(LOF(1), #3)
    Close #3
    
    ' --- načtení druhého XML ---
    Open cesta2 For Input As #3
        TxT2 = Input$(LOF(2), #3)
    Close #3
    
    ' odstranění hlaviček
  '  txt1 = Replace(txt1, "<?xml version=""1.0"" encoding=""utf-8""?>", "")
   ' txt2 = Replace(txt2, "<?xml version=""1.0"" encoding=""utf-8""?>", "")
    
    ' vytažení obsahu mezi root tagy
    body1 = Mid(txt1, InStr(txt1, ">") + 1)
    body1 = Left(body1, InStrRev(body1, "<") - 1)
    
    body2 = Mid(TxT2, InStr(TxT2, ">") + 1)
    body2 = Left(body2, InStrRev(body2, "<") - 1)
    
    ' vytvoření výsledného XML
    Dim Vysledek As String
    Vysledek = "<?xml version=""1.0"" encoding=""windows-1250""?>" & vbCrLf
    Vysledek = Vysledek & "<root>" & vbCrLf
    Vysledek = Vysledek & body1 & vbCrLf & body2 & vbCrLf
    Vysledek = Vysledek & "</root>"
    
    ' zapsání
    Open cestaVysledek For Output As #3
        Print #3, Vysledek
    Close #3
    
           FVystup = PathXml & "\JMHZ1.xml"
           If FileExist(FVystup) Then: Kill FVystup
           FVystup = PathXml & "\JMHZ2.xml"
           If FileExist(FVystup) Then: Kill FVystup
 
End Sub

