Private Sub UtvorJMHZ_XML_C()
' --- START CYKLU PŘES ZAMĚSTNANCE (Limit 1500 na XML balík) ---
Print #3, "<formularOsoby>"
' Hlavička konkrétního formuláře
Print #3, "      <hlavicka>"
Print #3, "        <idFormulare>" & SafeTrim(Text4) & "</idFormulare>" ' GUID formuláře osoby

Print #3, "        <typFormulare>" & SafeTrim(M10016) & "</typFormulare>" ' R/O/S
' ID 10495: Primární PPV. Označuje PPV nesoucí souhrnná data (SDZ).
Print #3, "        <primarniPpv>" & IIf(M10495, "true", "false") & "</primarniPpv>"
Print #3, "      </hlavicka>"

' Dynamický výběr kontejneru situace (Choice) na základě typu PPV
If formTag <> "odlozenyPrijem" Then: Print #3, "      <form:" & formTag & ">"

' SPECIFICKÝ ELEMENT PRO ODLOŽENÝ PŘÍJEM (Druh situace OP)
If formTag = "odlozenyPrijem" Then
    ' ID 10548: Typ Odloženého příjmu (1-bonusy, 2,3-náhrady neplatné výpovědi, 4-RZD).
    M10477 = "0": M10286 = "0"
    Print #3, "      <form:odlozenyPrijem>"
    Print #3, "        <form:typ>" & SafeTrim(M10548) & "</form:typ>"
       
End If

' 4.1 IDENTIFIKACE OSOBY (Sequence: Identifikace -> SDZ -> Pojištění)
Print #3, "        <form:identifikace>"
' Varianta 2: Zaměstnanec se známým IK MPSV (OIČ)
If SafeTrim(M10051) <> "" And Check6 = 0 Then
    Print #3, "          <form:ikMpsv>" & SafeTrim(M10051) & "</form:ikMpsv>" ' Osobní identifikační číslo
    Print #3, "          <form:idPpv>" & SafeTrim(M10228) & "</form:idPpv>" ' Identifikátor zaměstnání
Else ' Varianta 1/A1: Neztotožněné osoby (v manuálním šetření)
    Print #3, "          <form:prijmeni>" & SafeTrim(M10053) & "</form:prijmeni>" ' Příjmení dle dokladů
    Print #3, "          <form:jmeno>" & SafeTrim(M10054) & "</form:jmeno>" ' Jméno v nezkrácené podobě
    Print #3, "          <form:datumNarozeni>" & SafeTrim(M10056) & "</form:datumNarozeni>" ' Formát D.M.RRRR
    Print #3, "          <form:datumNastupu>" & SafeTrim(M10223) & "</form:datumNastupu>" ' Datum skutečného nástupu
     If SafeTrim(M10239) <> "" And formTag <> "odlozenyPrijem" Then: Print #3, "          <form:druhCinnosti>" & SafeTrim(M10239) & "</form:druhCinnosti>" ' Kód 1-9, A-ZC
End If
' ID 10502: Bližší určení PPV. Vyžadováno u specifických skupin (soudci, poslanci, vězni).
'If SafeTrim(M10502) <> "" Then
'    Print #3, "          <form:blizsiUrceniPpv>" & SafeTrim(M10502) & "</form:blizsiUrceniPpv>"
'End If
Print #3, "        </form:identifikace>"
    If formTag = "odlozenyPrijem" Then: GoTo odlozPrijem
' 4.2 SOUHRNNÁ DATA ZAMĚSTNANCE (SDZ) - Pouze pro Primární PPV
' Obsahuje daně a součty za všechna zaměstnání osoby u téhož plátce.
' If M10495 = False Then: a = a + 1: txt(a) = " Má vedlejší pracovní poměr - " + O(269)
 If M10495 = True And Val(SafeTrim(M10286)) > 0 Then

     Print #3, "        <form:souhrnDataZec>"
'  MsgBox (M10344)

    ' --- PŘÍJMY SDZ ---
    Print #3, "          <form:prijmy>"
    ' ID 10286: Zúčtovaný příjem celkem (včetně osvobozených). Mandatorní nula.
    Print #3, "            <form:zuctovanoCelkem>" & SafeTrim(M10286) & "</form:zuctovanoCelkem>"
    ' Zero Suppression: Odměny nerezidentům (§ 22 písm. g ZDP)
    If Val(SafeTrim(M10416)) > 0 Then
        Print #3, "            <form:odmenyNerezident>" & SafeTrim(M10416) & "</form:odmenyNerezident>"
    End If
    ' Zero Suppression: Osvobozené příjmy (§ 6 odst. 9 ZDP) a rozpis příspěvků
    If Val(SafeTrim(M10289)) > 0 Then

        Print #3, "            <form:osvobozenoCelkem>" & SafeTrim(M10289) & "</form:osvobozenoCelkem>"
        ' --- ROZPAD PŘÍSPĚVKŮ NA STÁŘÍ (ID 10417, 10292-10296, 10418) ---
        Print #3, "            <form:prispevekZamestnavatele>"
        ' ID 10417: Součet všech osvobozených příspěvků na stáří.
        Print #3, "              <form:prispevekZelSporeniOsvob>" & SafeTrim(M10417) & "</form:prispevekZelSporeniOsvob>"
        ' ID 10418: Příspěvek na pojištění dlouhodobé péče.
        Print #3, "              <form:prispevekZelPojDlPece>" & SafeTrim(M10418) & "</form:prispevekZelPojDlPece>"
        Print #3, "              <form:prispevekPenzPripoj>" & SafeTrim(M10292) & "</form:prispevekPenzPripoj>" ' Penzijní připojištění
        Print #3, "              <form:prispevekDoplnPenzPripoj>" & SafeTrim(M10293) & "</form:prispevekDoplnPenzPripoj>" ' Doplňkové penz. spoření
        Print #3, "              <form:prispevekPenzPoj>" & SafeTrim(M10294) & "</form:prispevekPenzPoj>" ' Penzijní pojištění
        Print #3, "              <form:prispevekZivotPoj>" & SafeTrim(M10295) & "</form:prispevekZivotPoj>" ' Životní pojištění
        Print #3, "              <form:prispevekDip>" & SafeTrim(M10296) & "</form:prispevekDip>" ' DIP - Dlouhodobý investiční produkt
        Print #3, "            </form:prispevekZamestnavatele>"
    End If
    Print #3, "          </form:prijmy>"

    ' --- ZÁLOHOVÁ DAŇ SDZ ---
   If M10495 = True And Val(SafeTrim(M10309)) = 0 Then
    Print #3, "          <form:zalohaNaDan>"
    Print #3, "            <form:zakladDane>" & SafeTrim(M10297) & "</form:zakladDane>" ' Úhrn příjmů ze záv. činnosti (§ 5 odst. 4 ZDP)
    Print #3, "            <form:vypoctenaZaloha>" & SafeTrim(M10298) & "</form:vypoctenaZaloha>" ' Daň ze základu před slevami
    Print #3, "            <form:danZalohaPoSleve>" & SafeTrim(M10305) & "</form:danZalohaPoSleve>" ' Skutečně sražená záloha
    If SafeTrim(M10306) <> "0" And SafeTrim(M10306) <> "" Then: Print #3, "            <form:danBonus>" & SafeTrim(M10306) & "</form:danBonus>" ' Vyplacený daňový bonus
    Print #3, "          </form:zalohaNaDan>"
   End If
    ' --- SRÁŽKOVÁ DAŇ SDZ (Zero Suppression) ---
    ' Uplatňuje se u DPP do limitu nebo nerezidentů.
    If Val(SafeTrim(M10309)) > 0 Or Val(SafeTrim(M10310)) > 0 Then
        Print #3, "          <form:zvlastniSazbaDane>"
        ' ID 10307: Základ pro srážkovou daň (§ 36 ZDP).
        Print #3, "            <form:zakladDane>" & SafeTrim(M10307) & "</form:zakladDane>"
        ' ID 10308: Odměna nerezidenta člena orgánu PO.
        Print #3, "            <form:srazenaDan>" & SafeTrim(M10309) & "</form:srazenaDan>" ' Sražená daň měsíční (§ 36 ZDP)
        If M10308 <> "0" Then: Print #3, "            <form:odmenaNerezident>" & SafeTrim(M10308) & "</form:odmenaNerezident>"
        If M10310 <> "0" Then: Print #3, "            <form:srazenaDanNerezident>" & SafeTrim(M10310) & "</form:srazenaDanNerezident>" ' Sražená daň nerezident (§ 36 ZDP)
        Print #3, "          </form:zvlastniSazbaDane>"
    End If

    ' ID 10419: Příznak podepsaného Prohlášení poplatníka (růžový tiskopis).
    Print #3, "          <form:prohlaseniPoplatnika>" & IIf(M10419, "true", "false") & "</form:prohlaseniPoplatnika>"

    ' --- SLEVY NA DANI SDZ (Uplatněné slevy z Prohlášení) ---
    If M10419 = True Then
        Print #3, "          <form:prohlaseniPoplatnikaDane>"
        Print #3, "            <form:zakladniSleva>" & SafeTrim(M10299) & "</form:zakladniSleva>" ' Sleva na poplatníka (§ 35ba odst. 1 písm. a)
        If SafeTrim(M10300) <> "" Then: Print #3, "            <form:zakladniSlevaInvalidita12>" & SafeTrim(M10300) & "</form:zakladniSlevaInvalidita12>" ' Invalidita I+II stupeň
        If SafeTrim(M10301) <> "" Then: Print #3, "            <form:rozsirenaSlevaInvalidita3>" & SafeTrim(M10301) & "</form:rozsirenaSlevaInvalidita3>" ' Invalidita III stupeň
        If SafeTrim(M10302) <> "" Then: Print #3, "            <form:slevaZTPP>" & SafeTrim(M10302) & "</form:slevaZTPP>" ' Sleva na držitele průkazu ZTP/P
          Print #3, "            <form:danoveZvyhodneniDetiMesic>" & SafeTrim(M10303) & "</form:danoveZvyhodneniDetiMesic>" ' Celkový úhrn zvýhodnění na děti
        ' --- ROZPIS VYŽIVOVANÝCH DĚTÍ V MĚSÍCI (1 až N) ---
        If PocetVyziDeti > 0 Then
            Print #3, "            <form:zvyhodneniDetiMesic>"
            ' ID 10453: Příznak, zda vyživuje jiná osoba ve stejné domácnosti.
            Print #3, "              <form:vyzivujeJinaOsoba>" & IIf(M10453, "true", "false") & "</form:vyzivujeJinaOsoba>"
            ' Cyklus přes jiné vyživující osoby v domácnosti
            If PocetSpolOsob > 0 Then
                Print #3, "              <form:jineOsoby>"
                For b = 1 To PocetSpolOsob
                    Print #3, "                <form:jinaOsoba>"
                    Print #3, "                  <form:jmeno>" & SafeTrim(M10431(b)) & "</form:jmeno>" ' Jméno spol. vyživující osoby
                    Print #3, "                  <form:prijmeni>" & SafeTrim(M10432(b)) & "</form:prijmeni>" ' Příjmení spol. vyživující osoby
                    Print #3, "                  <form:datumNarozeni>" & SafeTrim(M10433(b)) & "</form:datumNarozeni>" ' Datum nar.
                    Print #3, "                  <form:rodneCislo>" & SafeTrim(M10434(b)) & "</form:rodneCislo>" ' RČ
                      If SafeTrim(M10431(b)) <> "" And SafeTrim(M10434(b)) = "" Then: a = a + 1: txt(a) = "Doplňte rodné číslo manžela/ky nebo jiné pečující osoby (" + SafeTrim(M10431(b)) + ")"
                      If M10453 = True And SafeTrim(M10431(b)) = "" Then: a = a + 1: txt(a) = " Chybí jméno spol. vyživující osoby"
                      If M10453 = True And SafeTrim(M10432(b)) = "" Then: a = a + 1: txt(a) = " Chybí příjmení spol. vyživující osoby"
                      If M10453 = True And SafeTrim(M10433(b)) = "" Then: a = a + 1: txt(a) = " Chybí Datum narození dítěte"
                      If M10453 = True And SafeTrim(M10434(b)) = "" Then: a = a + 1: txt(a) = " Chybí rodné číslo"
                    Print #3, "                </form:jinaOsoba>"
                Next b
                Print #3, "              </form:jineOsoby>"
            End If
            ' Cyklus přes vyživované děti (Seznam dětí v měsíci)
            Print #3, "              <form:vyzivovaneDeti>"
            For b = 1 To PocetVyziDeti
                Print #3, "                <form:vyzivovaneDite>"
                Print #3, "                  <form:dite>"
                Print #3, "                    <form:jmeno>" & SafeTrim(M10435(b)) & "</form:jmeno>" ' Jméno dítěte
                Print #3, "                    <form:prijmeni>" & SafeTrim(M10436(b)) & "</form:prijmeni>" ' Příjmení dítěte
                Print #3, "                    <form:datumNarozeni>" & SafeTrim(M10437(b)) & "</form:datumNarozeni>" ' Datum nar.
                Print #3, "                    <form:rodneCislo>" & SafeTrim(M10438(b)) & "</form:rodneCislo>" ' RČ
                   If SafeTrim(M10435(b)) <> "" And SafeTrim(M10438(b)) = "" Then: a = a + 1: txt(a) = "Doplňte rodné číslo dítěte (" + SafeTrim(M10435(b)) + ")"
                      If M10453 = True And SafeTrim(M10435(b)) = "" Then: a = a + 1: txt(a) = " Chybí jméno dítěte"
                      If M10453 = True And SafeTrim(M10436(b)) = "" Then: a = a + 1: txt(a) = " Chybí příjmení dítěte"
                      If M10453 = True And SafeTrim(M10437(b)) = "" Then: a = a + 1: txt(a) = " Chybí Datum narození dítěte"
                      If M10453 = True And SafeTrim(M10438(b)) = "" Then: a = a + 1: txt(a) = " Chybí rodné číslo dítěte"
                      If M10453 = True And InStr(SafeTrim(M10438(b)), ".") > 0 Then: a = a + 1: txt(a) = " Špatný formát rodného čísla dítěte"
                      If M10453 = True And InStr(SafeTrim(M10438(b)), "/") > 0 Then: a = a + 1: txt(a) = " Špatný formát rodného čísla dítěte"
                      If M10453 = True And Len(SafeTrim(M10438(b))) <> 10 Then: a = a + 1: txt(a) = " Špatný formát rodného čísla dítěte"

                Print #3, "                  </form:dite>"
                ' ID 10439: Dítě je držitelem ZTP/P (nárok na dvojnásobné zvýhodnění).
                Print #3, "                  <form:prukazZtpp>" & IIf(M10439(b), "true", "false") & "</form:prukazZtpp>"
                ' ID 10440: Pořadí dítěte (1., 2., 3. a další) dle § 35c ZDP.
                Print #3, "                  <form:poradi>" & SafeTrim(M10440(b)) & "</form:poradi>"
                If M10453 = True And SafeTrim(M10440(b)) = "" Then: a = a + 1: txt(a) = " Chybí pořadí dítěte pro odečet daně"
                Print #3, "                </form:vyzivovaneDite>"
            Next b
            Print #3, "              </form:vyzivovaneDeti>"
            Print #3, "            </form:zvyhodneniDetiMesic>"
        End If
        ' ID 10304: Výše slevy na děti sražená měsíčně (§ 35c ZDP).
        Print #3, "            <form:slevaDite>" & SafeTrim(M10304) & "</form:slevaDite>"
        Print #3, "          </form:prohlaseniPoplatnikaDane>"
    End If

    ' --- ROČNÍ ÚHRNY / RZD SDZ (Položky uplatňované pouze v hlášení 01-03) ---
    ' Slouží pro podklady k daňovému přiznání a výsledky ročního zúčtování.
    If M10010 <= 2 Then
        Print #3, "          <form:rocniUhrny>"
         If M10010 = 1 Then: Print #3, "            <form:prijemSrazkDanZvlSazba>" & SafeTrim(M10311) & "</form:prijemSrazkDanZvlSazba>" ' Příjmy podléhající srážkové dani za rok
         If M10010 = 1 Then: Print #3, "            <form:danSrazenaZvlSazba>" & SafeTrim(M10312) & "</form:danSrazenaZvlSazba>" ' Srážková daň za rok
         If M10010 = 1 Then: Print #3, "            <form:prijemZdanitelnyCelkem>" & SafeTrim(M10313) & "</form:prijemZdanitelnyCelkem>" ' Úhrn zdanitelných příjmů za rok
         If M10010 = 1 Then: Print #3, "            <form:prijemZdanitelnyDoplatek>" & SafeTrim(M10316) & "</form:prijemZdanitelnyDoplatek>" ' Doplatky příjmů z min. období
         If M10010 = 1 Then: Print #3, "            <form:zalohaPrijmy>" & SafeTrim(M10317) & "</form:zalohaPrijmy>" ' Sražené zálohy za rok
         If M10010 = 1 Then: Print #3, "            <form:zalohaDoplatky>" & SafeTrim(M10318) & "</form:zalohaDoplatky>" ' Sražené zálohy z doplatků
         Print #3, "            <form:rocniZuctovaniZadost>" & IIf(M10319, "true", "false") & "</form:rocniZuctovaniZadost>" ' Zaměstnanec požádal o RZD
         Print #3, "            <form:rocniZuctovaniProvedeno>" & IIf(M10320, "true", "false") & "</form:rocniZuctovaniProvedeno>" ' RZD bylo provedeno

        ' --- VÝSLEDEK RZD (Sequence s detaily slev na partnera a děti v RZD) ---
    
        If M10320 = True Then
         
            Print #3, "            <form:vysledekRocnihoZuctovani>"
            ' ID 10321: Celkový přeplatek/doplatek z RZD (může být záporný).
            Print #3, "              <form:preplatekRok>" & SafeTrim(M10321) & "</form:preplatekRok>"
            Print #3, "              <form:danPreplatekRok>" & SafeTrim(M10322) & "</form:danPreplatekRok>" ' Přeplatek čistě na dani
            Print #3, "              <form:danBonusPreplatekRok>" & SafeTrim(M10323) & "</form:danBonusPreplatekRok>" ' Doplatek bonusu z RZD
            ' ID 10420: Uplatněna sleva na manželku/manžela v RZD (Příznak).
            Print #3, "              <form:uplatnenaSlevaNaPartnera>" & IIf(M10420, "true", "false") & "</form:uplatnenaSlevaNaPartnera>"
            Print #3, "            <form:uplatnenoZvyhodneniNaDeti>" & IIf(M10454, "true", "false") & "</form:uplatnenoZvyhodneniNaDeti>" ' Celkový úhrn zvýhodnění na děti

            Print #3, "            </form:vysledekRocnihoZuctovani>"
            ' Rozpis slevy na partnera (Cyklicky 1 až N partnerů v roce)
            If M10420 = True Then
                Print #3, "              <form:partneriSeznam>"
                For b = 1 To PocetPartneru
                    Print #3, "                <form:partner>"
                    Print #3, "                  <form:partnerUdaje>"
                    Print #3, "                    <form:jmeno>" & SafeTrim(M10421(b)) & "</form:jmeno>" ' Jméno partnera
                    Print #3, "                    <form:prijmeni>" & SafeTrim(M10422(b)) & "</form:prijmeni>" ' Příjmení partnera
                    Print #3, "                    <form:datumNarozeni>" & SafeTrim(M10424(b)) & "</form:datumNarozeni>" ' Datum nar.
                    Print #3, "                    <form:rodneCislo>" & SafeTrim(M10423(b)) & "</form:rodneCislo>" ' RČ partnera
                     If SafeTrim(M10421(b)) <> "" And SafeTrim(M10423(b)) = "" Then: a = a + 1: txt(a) = "Doplňte rodné číslo partnera/ky (" + SafeTrim(M10421(b)) + ")"
                      If M10420 = True And SafeTrim(M10421(b)) = "" Then: a = a + 1: txt(a) = " Chybí jméno partnera"
                      If M10420 = True And SafeTrim(M10422(b)) = "" Then: a = a + 1: txt(a) = " Chybí příjmení partnera"
                      If M10420 = True And SafeTrim(M10423(b)) = "" Then: a = a + 1: txt(a) = " Chybí rodné číslo partnera"
                      If M10420 = True And SafeTrim(M10424(b)) = "" Then: a = a + 1: txt(a) = " Chybí Datum narození dítěte"

                    Print #3, "                  </form:partnerUdaje>"
                    ' ID 10425: Partner je držitelem průkazu ZTP/P (dvojnásobná sleva).
                    Print #3, "                  <form:prukazZtpp>" & IIf(M10425(b), "true", "false") & "</form:prukazZtpp>"
                    ' ID 10426: Celkový počet měsíců uplatnění slevy v roce.
                    Print #3, "                  <form:slevaPocetMesicu>" & SafeTrim(M10426(b)) & "</form:slevaPocetMesicu>"
                    ' ID 10430: Z toho počet měsíců, kdy byl partner držitelem ZTP/P.
                    Print #3, "                  <form:slevaPocetMesicuZtpp>" & SafeTrim(M10430(b)) & "</form:slevaPocetMesicuZtpp>"
