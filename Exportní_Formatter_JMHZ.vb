    Print #3, "      <so:danBonusDoplatek>" & SafeTrim(M10037) & "</so:danBonusDoplatek>" ' Úhrn doplatků bonusů z RZD
    Print #3, "    </so:danUdajeRok>"
End If

' SCÉNÁŘ STATISTIKA: Údaje k 31.12. (uváděné pouze v prosinci)
If M10010 = 12 And Val(M10038) > 25 Then
    Print #3, "    <so:zamestnavatelUdajeRok>"
    ' ID 10220: Forma hospodářské a finanční kontroly (požaduje Eurostat)
    If SafeTrim(M10220) <> "" Then: Print #3, "      <so:formaVlastnictvi>" & SafeTrim(M10220) & "</so:formaVlastnictvi>"
