        If SafeTrim(M10376) = "3" And SafeTrim(M10525) <> "" Then sLine = sLine & " typeempl=" & U & SafeTrim(M10525) & U:
        If SafeTrim(M10376) = "" And SafeTrim(M10525) <> "" Then sLine = sLine & " typeempl=" & U & SafeTrim(M10525) & U:
     If SafeTrim(M10376) <> "2" Then
        If SafeTrim(M10376) <> "3" And Not (SafeTrim(M10239) Like "[MNOPQRS]") Then
            
            If SafeTrim(M10380) <> "" Then sLine = sLine & " rsnterempl=" & U & SafeTrim(M10380) & U
            If SafeTrim(M10381) <> "" Then sLine = sLine & " rsnterrel=" & U & SafeTrim(M10381) & U
        End If
        If SafeTrim(M10378) = "A" Then sLine = sLine & " belong=" & U & "A" & U
        If SafeTrim(M10379) = "A" Then sLine = sLine & " fullpay=" & U & "A" & U
        If Val(SafeTrim(M10377)) > 0 And SafeTrim(M10376) <> "3" Then sLine = sLine & " avgmonear=" & U & SafeTrim(M10377) & U
        If SafeTrim(M10376) <> "4" And SafeTrim(M10376) <> "5" Then
            If Val(M10530) > 0 Then sLine = sLine & " replacement=" & U & CStr(Val(M10530)) & U
            If Val(M10531) > 0 Then sLine = sLine & " goldenhandshake=" & U & CStr(Val(M10531)) & U
            If Val(M10532) > 0 Then sLine = sLine & " severancepay=" & U & CStr(Val(M10532)) & U
            If Val(M10533) > 0 Then sLine = sLine & " disposal=" & U & CStr(Val(M10533)) & U
        End If
        
        If bCizinec And SafeTrim(M10534) <> "" Then sLine = sLine & " earlyterm=" & U & SafeTrim(M10534) & U
        
        Print #5, sLine & ">"

        ' Intervaly důchodového pojištění (pro A2 jen "to")
    
        For i = 1 To PocetPenzijnichIntervalu
            If SafeTrim(M10386(i)) <> "" And SafeTrim(M10386(i)) <> "0000-00-00" Then
               sLine = "        <pensionperiod fro=" & U & SafeTrim(M10387(i)) & U
                Print #5, sLine & " to=" & U & SafeTrim(M10387(i)) & U & "/>"
            End If
        Next i

        Print #5, "    </unemplcomp>"
      End If 'SafeTrim(M10225) <> "2"
    End If ' SafeTrim(M10225) <> "A"

    ' --- Přílohy (stejný kód jako u A3) ---
    If PocetPriloh > 0 Then
        Print #5, "    <attachs>"
        For i = 1 To PocetPriloh
            If SafeTrim(M10396(i)) <> "" Then
                sLine = "        <attach name=" & U & SafeTrim(M10396(i)) & U
                If SafeTrim(M10397(i)) <> "" Then sLine = sLine & " desc=" & U & SafeTrim(M10397(i)) & U
                If SafeTrim(M10400(i)) <> "" Then sLine = sLine & " data=" & U & SafeTrim(M10400(i)) & U
                Print #5, sLine & "/>"
            End If
        Next i
        Print #5, "    </attachs>"
    End If

    Print #5, "  </employee>"
    TiskniJMHZ
    Exit Sub
End Sub
' --- HLAVNÍ BLOK PRO GENEROVÁNÍ PODÁNÍ (Řešení Globálního Storna) ---
Private Sub UtvorJMHZ_XML_KompletStorno()
    ' M10001 = GUID řádného podání, na které se storno/oprava váže (musí být shodné s původním)
    ' M10007 = Typ podání (R - Řádné, O - Opravné, S - Storno)
U = Chr(34)
FVystup = PathXml & "\" & "MH_" & "STORNO_komplet" & ".xml"
'Open FVystup For Output As #3
    'Print #3, "<jmhz>"
    ' (Zde by se vygenerovaly systémové obálky VENDOR a SENDER)
    Open FVystup For Output As #3

Print #3, "<?xml version=" & U & "1.0" & U & " encoding=" & U & "windows-1250" & U & "?>"
Print #3, "<jmhz xmlns=" & U & "http://schemas.cssz.cz/JMHZ/podani/1.0" & U
Print #3, "    xmlns:so=" & U & "http://schemas.cssz.cz/JMHZ/souhrn/1.0" & U
Print #3, "    xmlns:pvpoj=" & U & "http://schemas.cssz.cz/JMHZ/PVPOJ/1.0" & U
Print #3, "    xmlns:form=" & U & "http://schemas.cssz.cz/JMHZ/form/1.0" & U
Print #3, "    xmlns:xsi=" & U & "http://www.w3.org/2001/XMLSchema-instance" & U
Print #3, "    verze=" & U & "1.4.3.4" & U & ">"

'Print #3, "  Žlutý"
'Close #3
'Exit Sub
' --- 1. HLAVIČKA PODÁNÍ (Metadata podání) ---
' Obsahuje technické identifikátory pro systém DIS/cJMHZ
    Print #3, "  <hlavicka>"
    Print #3, "    <idPodani>" & SafeTrim(Text3) & "</idPodani>"
    Print #3, "    <typPodani>" & SafeTrim(M10007) & "</typPodani>"
    Print #3, "    <variabilniSymbol>" & SafeTrim(M10221) & "</variabilniSymbol>"
    Print #3, "    <mesic>" & SafeTrim(M10010) & "</mesic>"
    Print #3, "    <rok>" & SafeTrim(M10011) & "</rok>"
    Print #3, "    <datumVyplneni>" & SafeTrim(M10005) & "</datumVyplneni>" ' ISO formát

    ' (Další meta atributy jako datumVyplneni, balikPoradi, balikyPocet...)
    Print #3, "  </hlavicka>"

    ' ==============================================================================
    ' 1. SCÉNÁŘ: HROMADNÉ STORNO CELÉHO PODÁNÍ ZA CELOU FIRMU
    ' ==============================================================================
    ' Pravidlo dle Katalogu kontrol (Chyba 20308 / ID kontroly 308):
    ' V podání typu storno (M10007 = "S") se nesmí nacházet součásti:
    ' pvpoj, souhrn ani individualizované formuláře osob.
    'If UCase(SafeTrim(M10007)) = "S" Then
        ' Zde okamžitě ukončíme generování. XML bude obsahovat POUZE hlavičku.
        Print #3, "</jmhz>"
        Close #3
        MsgBox ("Soubor " & FVystup & " byl vytvořen")
        Exit Sub
    'End If

    ' --- Pokud se nejedná o globální storno (je to R nebo O), pokračujeme ---
    ' Call UtvorJMHZ_XML_A ' (Tisk uzlu so:souhrn)
    ' Call UtvorJMHZ_XML_B ' (Tisk uzlu pvpoj:PVPOJ)

    ' 3. INDIVIDUALIZOVANÁ ČÁST (zaměstnanci)
    Print #3, "  <formulareOsob>"
    
    ' ... Zde začíná cyklus přes všechny zaměstnance (Recordset) ...
    Call UtvorJMHZ_XML_C_Storno_Zamestnance
    ' ... Konec cyklu ...
    
    Print #3, "  </formulareOsob>"
    Print #3, "</jmhz>"
  
End Sub

' --- BLOK PRO INDIVIDUALIZOVANÝ FORMULÁŘ (Řešení individuálního storna) ---
Private Sub UtvorJMHZ_XML_C_Storno_Zamestnance()
    ' M10012 = GUID konkrétního formuláře zaměstnance z předchozího podání
    ' M10016 = Typ formuláře (R - Řádný, O - Opravný, S - Storno)
    U = Chr(34)
        Open FVystup For Output As #3

Print #3, "<?xml version=" & U & "1.0" & U & " encoding=" & U & "windows-1250" & U & "?>"
Print #3, "<jmhz xmlns=" & U & "http://schemas.cssz.cz/JMHZ/podani/1.0" & U
Print #3, "    xmlns:so=" & U & "http://schemas.cssz.cz/JMHZ/souhrn/1.0" & U
Print #3, "    xmlns:pvpoj=" & U & "http://schemas.cssz.cz/JMHZ/PVPOJ/1.0" & U
Print #3, "    xmlns:form=" & U & "http://schemas.cssz.cz/JMHZ/form/1.0" & U
Print #3, "    xmlns:xsi=" & U & "http://www.w3.org/2001/XMLSchema-instance" & U
Print #3, "    verze=" & U & "1.4.3.4" & U & ">"


    Print #3, "    <formularOsoby>"
    Print #3, "      <hlavicka>"
    Print #3, "        <idFormulare>" & SafeTrim(Text4) & "</idFormulare>"
    Print #3, "        <typFormulare>" & SafeTrim(M10016) & "</typFormulare>"
    Print #3, "    <variabilniSymbol>" & SafeTrim(M10221) & "</variabilniSymbol>" ' VS mzdové účtárny
    Print #3, "    <mesic>" & SafeTrim(M10010) & "</mesic>" ' Období hlášení
    Print #3, "    <rok>" & SafeTrim(M10011) & "</rok>"
    Print #3, "    <datumVyplneni>" & SafeTrim(M10005) & "</datumVyplneni>" ' ISO formát
    Print #3, "        <primarniPpv>" & IIf(M10495, "true", "false") & "</primarniPpv>"
    Print #3, "      </hlavicka>"
    Print #3, "    </formularOsoby>"
    Print #3, "</jmhz>"
Close #3
    MsgBox ("Soubor " & FVystup & " byl vytvořen")
End Sub
Private Sub Command22_Click()
Dim HledejGUID As String
Dim RsHled As Recordset
      
   If Len(Trim(Text5)) <> 36 And Trim(Text5) <> "" Then: MsgBox ("GUID má chybný počet znaků - " & Len(Trim(Text5))): Exit Sub
   If Trim(Text5) = "" Then: Exit Sub
      HledejGUID = Text5
          Set RsHled = DbUdaje.OpenRecordset("SELECT OsCislo From DataPaM WHERE  PoNapln = """ & HledejGUID & """ ")
      
      On Error GoTo Nenasel
      RsHled.MoveFirst
     
       ZOsCislo = Trim(RsHled.Fields("oscislo"))
         Rszam.MoveFirst
          For a = 1 To MaxZam
           If Trim(ZOsCislo) = Trim(Rszam.Fields("OsCislo")) Then
             ZOsCislo = Rszam.Fields("OsCislo")
             ZJmeno = Rszam.Fields("jmeno")
             ZPrijmeni = Rszam.Fields("prijmeni")
             ZStredisko = Rszam.Fields("stredisko")
             Exit For
            End If
            Rszam.MoveNext
          Next a
         Msg = "Hledaný zaměstnanec je " + Trim(ZOsCislo) + " " + Trim(ZPrijmeni) + " " + Trim(ZJmeno) + ". Mám ho ukázat s vyplněnými položkami?"
           MsgOtaznik
          If Odpoved = vbYes Then
              ' MsgBox "Přerušuji tvorbu xml! "
                 NactiData
                 PrepisData
                 ResultText(2) = ""
                 Unload Me
          End If

         
Exit Sub
Nenasel:
Msg = "Guid zaměstnance neexistuje."
MsgVykricnik
End Sub
