Sub NactiStrediskoPodleNazvu(Nazev As String)

 Dim db As DAO.Database
    Dim Rs As DAO.Recordset
    Dim cesta As String
    Dim sql As String
      
    cesta = PathDta
    Set db = DBEngine.OpenDatabase(cesta, False, False, ";PWD=Salary21")

    ' ----------------------------------------------------------------------------------
    ' OPRAVA: Obousměrný Trim (Ochrana proti skrytým mezerám v legacy datech)
    ' Používáme SQL funkci Trim() přímo na sloupec 'stNazev' a zároveň VB6 funkci Trim()
    ' na vstupní proměnnou 'HledanyNazev'. Tím zajistíme 100% shodu čistého textu.
    ' ----------------------------------------------------------------------------------
    sql = "SELECT * FROM Stredisko WHERE Trim(stNazev) = '" & Trim(Replace(Nazev, "'", "''")) & "'"
    
    Set Rs = db.OpenRecordset(sql, dbOpenSnapshot)
    
    If Rs.EOF Then
        ' Zde také přidán Trim() pro případ, že chyba byla ve vstupu od uživatele
       ' MsgBox "?? Středisko '" & Trim(Nazev) & "' nebylo nalezeno.", vbExclamation
    Else
        Do While Not Rs.EOF
            ' Defenzivní flat-coding proti Null hodnotám (zůstává beze změny)
            If IsNull(Rs!stNazev) Then Nazev = "" Else Nazev = Rs!stNazev
            If IsNull(Rs!stUlice) Then Ulice = "" Else Ulice = Rs!stUlice
            If IsNull(Rs!StPopis) Then Popis = "" Else Popis = Rs!StPopis
            If IsNull(Rs!stOrient) Then Orient = "" Else Orient = Rs!stOrient
            If IsNull(Rs!stPSC) Then PSC = "" Else PSC = Rs!stPSC
            If IsNull(Rs!stObec) Then Obec = "" Else Obec = Rs!stObec
            If IsNull(Rs!stKodObec) Then KodObec = "" Else KodObec = Rs!stKodObec
            If IsNull(Rs!stStat) Then Stat = "" Else Stat = Rs!stStat
            
            ' Dobrá praxe: vyčištění výstupních proměnných od případných mezer z databáze
           
           
           If Trim(Obec) <> "" Then
         '   If Trim(Stat) = "" Then: MsgBox ("Chybí stát u střediska " & Nazev)
         '   If Trim(Ulice) = "" Then: MsgBox ("Chybí ulice u střediska " & Nazev)
           End If
            
            ' Výpis nalezených dat
           ' MsgBox (Obec & "  " & Nazev)
            
            Rs.MoveNext
        Loop
    End If

    ' Uzavření objektů a uvolnění paměti
    Rs.Close
    Set Rs = Nothing
    db.Close
    Set db = Nothing
End Sub
