' Hlavní volající procedura pro sestavení celého XML
Public Sub ExportRegzelDopl()
FVystup = PathXml & "\" & "RegzelDopl" & ".xml"
Open FVystup For Output As #5
  '  Call PrintEnvelopeAndVendor
        Print #5, "<?xml version=""1.0"" encoding=""windows-1250""?>"
    
    ' Kořenový element s namespace a atributem partialAccept
    Print #5, "<REGZELDOPL xmlns=""http://schemas.cssz.cz/REGZELDOPL/2025"" partialAccept=""0"">"
    
    ' Hlavička odesílacího softwaru
    Print #5, "    <VENDOR productName=""SALARY"" productVersion=""1.0.0""/>"
    
    ' MEmailNotifikace reprezentuje email pro zaslání odpovědi z DIS
    If SafeTrim(M10137) <> "" Then
        Print #5, "    <SENDER EmailNotifikace=""" & SafeTrim(M10137) & """ ISDSreport=""3"" VerzeProtokolu=""1.0""/>"
    Else
        Print #5, "    <SENDER ISDSreport=""3"" VerzeProtokolu=""1.0""/>"
    End If

    Print #5, "    <formular>"
   ' Call PrintHlavicka
        Print #5, "        <hlavicka>"
    
    ' ID 10004: Pracoviště ÚSSZ (OSSZ/PSSZ/MSSZ Brno) z CIS Okresy (3 znaky)
    Print #5, "            <kodPracovisteCSSZ>" & SafeTrim(M10004) & "</kodPracovisteCSSZ>"
    
    ' ID 10411: Kód Finančního úřadu nebo Specializovaného FÚ (4 znaky) - Povinné
    Print #5, "            <kodFU>" & SafeTrim(M10411) & "</kodFU>"
    
    ' ID 10412: Kód Územního pracoviště (4 znaky) - Nepovinné
    ' Podmínka: Specializovaný FÚ (Kód 4000) územní pracoviště nemá, nesmí se tag generovat
    If SafeTrim(M10412) <> "" And SafeTrim(M10411) <> "4000" Then
        Print #5, "            <kodPracovisteFU>" & SafeTrim(M10412) & "</kodPracovisteFU>"
    End If
    
    Print #5, "        </hlavicka>"
    'Call PrintZamestnavatel
       Print #5, "        <zamestnavatel>"
    
    ' ID 10221: Variabilní symbol zaměstnavatele/účtárny (10 znaků) - Primární klíč
    Print #5, "            <vs>" & SafeTrim(M10221) & "</vs>"
    
    ' ID 10123: Vlastní číslo plátce (VČP) (9 znaků) - Nepovinné (musí začínat na "6")
    If Val(SafeTrim(M10123)) > 0 Then
        Print #5, "            <vcp>" & SafeTrim(M10123) & "</vcp>"
    End If
    
    ' ID 10140: ID datové schránky pro notifikace (7 znaků) - Nepovinné
    If SafeTrim(M10140) <> "" Then
        Print #5, "            <datovaSchranka>" & SafeTrim(M10140) & "</datovaSchranka>"
    End If
    
    ' Vnořený uzel pro statistické příznaky (Boolean: 1/0)
    Print #5, "            <doplnInformace>"
    
    ' ID 10212: Integrační sociální podnik (Povinné - Ano/Ne)
    ' Funkce IIf vrací "1" pro True a "0" pro False (Standardní převod z boolean proměnné)
    Print #5, "                <socialniPodnik>" & M10212 & "</socialniPodnik>"
    
    ' ID 10210: Agentura práce (Povinné - Ano/Ne)
    Print #5, "                <agenturaPrace>" & M10210 & "</agenturaPrace>"
    
    ' ID 10211: Zaměstnavatel uznaný na chráněném trhu práce § 78 (Povinné - Ano/Ne)
    Print #5, "                <chranenyTrh>" & M10211 & "</chranenyTrh>"
    
    Print #5, "            </doplnInformace>"
    Print #5, "        </zamestnavatel>"
    Print #5, "    </formular>"
    Print #5, "</REGZELDOPL>"
Close #5
 MsgBox ("Soubor " & FVystup & " byl vytvořen!")
End Sub
