    Print #3, "        <so:podilZamZtp>" & SafeTrim(M10452) & "</so:podilZamZtp>" ' Výpočet podílu v % (ID 10039 / 10038)
    Print #3, "      </so:zamestnavaniOzp>"
    ' Kolektivní smlouvy (Cyklický rozpis 1 až N)
    If PocetKS > 0 Then
        Print #3, "      <so:kolektivniSmlouvy>"
        For b = 1 To PocetKS
            Print #3, "        <so:kolektivniSmlouva>"
            ' ID 10214: Typ kolektivní smlouvy (0-neexistuje, 1-podniková, atd.)
            Print #3, "          <so:typKolektSmlouvy>" & SafeTrim(M10214(b)) & "</so:typKolektSmlouvy>"
            Print #3, "        </so:kolektivniSmlouva>"
        Next b
        Print #3, "      </so:kolektivniSmlouvy>"
    End If
    Print #3, "    </so:zamestnavatelUdajeRok>"
End If

' SCÉNÁŘ ROZHODNÁ SKUTEČNOST: Likvidace, úpadek, smrt plátce (Měsíční periodicita)
If SafeTrim(M10408) <> "" Then
    Print #3, "    <so:specifickaSkutecnost>"
    ' ID 10408: Typ specifické právní skutečnosti dle číselníku GFŘ
    Print #3, "      <so:typ>" & SafeTrim(M10408) & "</so:typ>"
    ' ID 10409: Datum nastání skutečnosti (musí spadat do hlášeného měsíce)
    Print #3, "      <so:datum>" & SafeTrim(M10409) & "</so:datum>"
    Print #3, "    </so:specifickaSkutecnost>"
End If
Print #3, "  </so:souhrn>"




