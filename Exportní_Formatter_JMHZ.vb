  Else
    M10001 = Text3
     If Check6.Value = 0 Then
        If PismenoCo = "R" Then: MsgBox ("Vaše Řádné podání je již na e-portálu. Vytvořit můžete pouze Opravné nebo Storno!"): ProgressBar1.Visible = False: s = "end": Exit Sub
     End If
  End If
End If


  'zacatek
    
 U = Chr$(34) ' Uvozovky
 CorrID = ""
 Pozn = ""
 
 a = a + 1: txt(a) = "----------   Povinná část systém plní Automaticky ---------------------"
 

' ======================================= HLAVIČKA XML a NAMESPACY (Oprava A) =======================================
' Implementace technické hlavičky XML a kořenového elementu podání (ID 10001, 10007, 10221, 10010, 10011, 10005, 10002, 10003, 10015, 10488)
Close #3
Open FVystup For Output As #3

' --- INICIALIZACE PODÁNÍ ---
' Definice jmenných prostorů dle jmhzPodani.xsd

Print #3, "<?xml version=" & U & "1.0" & U & " encoding=" & U & "windows-1250" & U & "?>"
Print #3, "<jmhz xmlns=" & U & "http://schemas.cssz.cz/JMHZ/podani/1.0" & U
Print #3, "    xmlns:so=" & U & "http://schemas.cssz.cz/JMHZ/souhrn/1.0" & U
Print #3, "    xmlns:pvpoj=" & U & "http://schemas.cssz.cz/JMHZ/PVPOJ/1.0" & U
Print #3, "    xmlns:form=" & U & "http://schemas.cssz.cz/JMHZ/form/1.0" & U
Print #3, "    xmlns:xsi=" & U & "http://www.w3.org/2001/XMLSchema-instance" & U
Print #3, "    verze=" & U & "1.4.3.4" & U & ">"

'Print #3, "  Žlutý"
'Close #3
'Exit Sub
' --- 1. HLAVIČKA PODÁNÍ (Metadata podání) ---
' Obsahuje technické identifikátory pro systém DIS/cJMHZ
Print #3, "  <hlavicka>"
Print #3, "    <idPodani>" & SafeTrim(Text3) & "</idPodani>" ' GUID podání
Print #3, "    <typPodani>" & SafeTrim(M10007) & "</typPodani>" ' R/O/S
' ID 10470: Kanál podání (APEP/VREP/ISDS). Technický atribut pro auditní stopu.
'Print #3, "    <kanalPodani>" & SafeTrim(M10470) & "</kanalPodani>"

Print #3, "    <variabilniSymbol>" & SafeTrim(M10221) & "</variabilniSymbol>" ' VS mzdové účtárny
Print #3, "    <mesic>" & SafeTrim(M10010) & "</mesic>" ' Období hlášení
Print #3, "    <rok>" & SafeTrim(M10011) & "</rok>"
Print #3, "    <datumVyplneni>" & SafeTrim(M10005) & "</datumVyplneni>" ' ISO formát
' Technické atributy balíku - nutné pro integritu u velkých zaměstnavatelů
Print #3, "    <balikPoradi>" & SafeTrim(M10002) & "</balikPoradi>" ' Pořadí XML souboru v podání
Print #3, "    <balikyPocet>" & SafeTrim(M10003) & "</balikyPocet>" ' Celkový počet souborů
Print #3, "    <formularePocetVBaliku>" & SafeTrim(M10015) & "</formularePocetVBaliku>" ' Počet osob v tomto XML
Print #3, "    <formularePocetCelkem>" & SafeTrim(M10488) & "</formularePocetCelkem>" ' Počet osob celkem za podání
Print #3, "  </hlavicka>"

